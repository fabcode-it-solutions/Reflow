{
  "version": 2,
  "builds": [
    {
      "src": "reflow-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "reflow-app/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/reflow-backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/reflow-app/dist/$1"
    }
  ]
}
